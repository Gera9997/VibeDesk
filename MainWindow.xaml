<Window x:Class="VibeDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VibeDesk" Height="660" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize"
        Icon="Assets/icon.ico">

    <Window.Resources>
        <!-- Dynamic Palette Brushes for Live Theme Switching -->
        <SolidColorBrush x:Key="WindowBg" Color="#BFC3C7"/>
        <SolidColorBrush x:Key="WindowTint" Color="#00000000"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#BFC3C7"/>
        <SolidColorBrush x:Key="HeaderBorder" Color="#73FFFFFF"/>
        <SolidColorBrush x:Key="FooterBg" Color="#BFC3C7"/>
        <SolidColorBrush x:Key="FooterBorder" Color="#73FFFFFF"/>
        <SolidColorBrush x:Key="GlassPanelBg" Color="#BFC3C7"/>
        <SolidColorBrush x:Key="GlassPanelBorder" Color="#73FFFFFF"/>
        <SolidColorBrush x:Key="AccentColor" Color="#080808"/>
        <SolidColorBrush x:Key="PrimaryBtnBg" Color="#080808"/>
        <SolidColorBrush x:Key="PrimaryBtnFg" Color="#BFC3C7"/>
        <SolidColorBrush x:Key="PrimaryBtnBorder" Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryBtnHoverBg" Color="#222222"/>
        <SolidColorBrush x:Key="PrimaryBtnHoverBorder" Color="#55FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryBtnPressedBg" Color="#111111"/>
        <SolidColorBrush x:Key="PrimaryBtnPressedBorder" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryBtnBg" Color="#BFC3C7"/>
        <SolidColorBrush x:Key="SecondaryBtnBorder" Color="#80FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryBtnFg" Color="#080808"/>
        <SolidColorBrush x:Key="SecondaryBtnHoverBg" Color="#C8CCD1"/>
        <SolidColorBrush x:Key="SecondaryBtnHoverBorder" Color="#B3FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryBtnPressedBg" Color="#B4B8BC"/>
        <SolidColorBrush x:Key="SecondaryBtnPressedBorder" Color="#50FFFFFF"/>
        <SolidColorBrush x:Key="ModernTextBoxBg" Color="#B8BCBF"/>
        <SolidColorBrush x:Key="ModernTextBoxBorder" Color="#4DFFFFFF"/>
        <SolidColorBrush x:Key="ModernTextBoxFg" Color="#080808"/>
        <SolidColorBrush x:Key="LogBoxBg" Color="#B8BCBF"/>
        <SolidColorBrush x:Key="LogBoxBorder" Color="#4DFFFFFF"/>
        <SolidColorBrush x:Key="LogBoxFg" Color="#080808"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#080808"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94080808"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B080808"/>
        <SolidColorBrush x:Key="RecentItemBg" Color="#BFC3C7"/>
        <SolidColorBrush x:Key="RecentItemBorder" Color="#73FFFFFF"/>
        <SolidColorBrush x:Key="RecentItemHoverBg" Color="#C8CCD1"/>
        <SolidColorBrush x:Key="RecentItemHoverBorder" Color="#B3FFFFFF"/>
        <SolidColorBrush x:Key="ThumbnailBg" Color="#BFC3C7"/>
        <SolidColorBrush x:Key="ThumbnailBorder" Color="#50FFFFFF"/>
        <SolidColorBrush x:Key="ArrowBtnBg" Color="#BFC3C7"/>
        <SolidColorBrush x:Key="ArrowBtnBorder" Color="#80FFFFFF"/>
        <SolidColorBrush x:Key="ArrowBtnHoverBg" Color="#C8CCD1"/>
        <SolidColorBrush x:Key="ArrowBtnHoverBorder" Color="#B3FFFFFF"/>
        <SolidColorBrush x:Key="BadgeBg" Color="#B8BCBF"/>
        <SolidColorBrush x:Key="BadgeBorder" Color="#66FFFFFF"/>
        <SolidColorBrush x:Key="RecessedBg" Color="#B8BCBF"/>
        <SolidColorBrush x:Key="InsetBevelBorder" Color="#4DFFFFFF"/>

        <!-- Dynamic Neumorphic Physics Colors for Dual Drop Shadows -->
        <Color x:Key="ShadowLightColor">#8CFFFFFF</Color>
        <Color x:Key="ShadowDarkColor">#3D080808</Color>
        <Color x:Key="BtnShadowLightColor">#99FFFFFF</Color>
        <Color x:Key="BtnShadowDarkColor">#42080808</Color>
        <Color x:Key="PrimaryLightColor">#80FFFFFF</Color>
        <Color x:Key="PrimaryDarkColor">#59080808</Color>
        <Color x:Key="InsetTopDarkColor">#47080808</Color>
        <Color x:Key="InsetTopMidColor">#1F080808</Color>
        <Color x:Key="InsetBotLightColor">#8CFFFFFF</Color>
        <Color x:Key="RecentFadeStartColor">#00BFC3C7</Color>
        <Color x:Key="RecentFadeMidColor">#A0BFC3C7</Color>
        <Color x:Key="RecentFadeEndColor">#FFBFC3C7</Color>

        <!-- Convex Container / Section Panel: Extruded from solid silver sheet with dual shadows & bevel -->
        <Style x:Key="GlassPanel" TargetType="ContentControl">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <!-- Top-Left Light Highlight Shadow (-7px -7px 16px rgba(255,255,255,0.55)) -->
                            <Border CornerRadius="22" Background="{DynamicResource GlassPanelBg}">
                                <Border.Effect>
                                    <DropShadowEffect Direction="135" ShadowDepth="7" BlurRadius="16"
                                                      Color="{DynamicResource ShadowLightColor}"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <!-- Bottom-Right Dark Shadow (7px 7px 16px rgba(8,8,8,0.24)) -->
                            <Border CornerRadius="22" Background="{DynamicResource GlassPanelBg}">
                                <Border.Effect>
                                    <DropShadowEffect Direction="315" ShadowDepth="7" BlurRadius="16"
                                                      Color="{DynamicResource ShadowDarkColor}"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>
                            <!-- Top Surface with Micro-Bevel (1px solid rgba(255,255,255,0.45)) -->
                            <Border Background="{DynamicResource GlassPanelBg}"
                                    BorderBrush="{DynamicResource GlassPanelBorder}"
                                    BorderThickness="1"
                                    CornerRadius="22"
                                    Padding="22">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button: Hard inversion deep obsidian black #080808 with silver text & dual shadows -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="PriRoot" RenderTransformOrigin="0.5,0.5">
                            <!-- Top-Left Light Highlight (-4px -4px 10px rgba(255,255,255,0.5)) -->
                            <Border x:Name="PriLightShadow"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="14">
                                <Border.Effect>
                                    <DropShadowEffect Direction="135" ShadowDepth="4" BlurRadius="10"
                                                      Color="{DynamicResource PrimaryLightColor}"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>

                            <!-- Bottom-Right Dark Shadow (5px 5px 12px rgba(8,8,8,0.35)) -->
                            <Border x:Name="PriDarkShadow"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="14">
                                <Border.Effect>
                                    <DropShadowEffect Direction="315" ShadowDepth="5" BlurRadius="12"
                                                      Color="{DynamicResource PrimaryDarkColor}"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>

                            <!-- Obsidian Black Button Surface -->
                            <Border x:Name="PriBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PriBorder" Property="Background" Value="{DynamicResource PrimaryBtnHoverBg}"/>
                                <Setter TargetName="PriBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBtnHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PriRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="PriBorder" Property="Background" Value="{DynamicResource PrimaryBtnPressedBg}"/>
                                <Setter TargetName="PriLightShadow" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PriDarkShadow" Property="Opacity" Value="0.25"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PriBorder" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="PriLightShadow" Property="Opacity" Value="0.1"/>
                                <Setter TargetName="PriDarkShadow" Property="Opacity" Value="0.1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Convex Interactive Buttons: Silver tactile button with dual shadows, bevel, and active deboss -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorder}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="SecRoot" RenderTransformOrigin="0.5,0.5">
                            <!-- Convex State: Top-Left Specular Light Highlight (-4px -4px 10px rgba(255,255,255,0.6)) -->
                            <Border x:Name="SecLightShadow"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="14">
                                <Border.Effect>
                                    <DropShadowEffect Direction="135" ShadowDepth="4" BlurRadius="10"
                                                      Color="{DynamicResource BtnShadowLightColor}"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>

                            <!-- Convex State: Bottom-Right Dark Shadow (4px 4px 10px rgba(8,8,8,0.26)) -->
                            <Border x:Name="SecDarkShadow"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="14">
                                <Border.Effect>
                                    <DropShadowEffect Direction="315" ShadowDepth="4" BlurRadius="10"
                                                      Color="{DynamicResource BtnShadowDarkColor}"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>

                            <!-- Debossed Inset Plate (Instant transition on IsPressed=True) -->
                            <Border x:Name="SecInsetPlate"
                                    Background="{DynamicResource RecessedBg}"
                                    CornerRadius="14"
                                    Opacity="0"
                                    BorderThickness="1">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#48080808" Offset="0.0"/>
                                        <GradientStop Color="#18080808" Offset="0.3"/>
                                        <GradientStop Color="#50FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>

                            <!-- Top Surface with Micro-Bevel (border: 1px solid rgba(255,255,255,0.5)) -->
                            <Border x:Name="SecBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="{DynamicResource SecondaryBtnHoverBg}"/>
                                <Setter TargetName="SecBorder" Property="BorderBrush" Value="{DynamicResource SecondaryBtnHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecRoot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="SecLightShadow" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="SecDarkShadow" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="SecBorder" Property="Opacity" Value="0"/>
                                <Setter TargetName="SecInsetPlate" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SecBorder" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="SecLightShadow" Property="Opacity" Value="0.2"/>
                                <Setter TargetName="SecDarkShadow" Property="Opacity" Value="0.2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Convex Header Pill Button: Capsule style with CornerRadius="999" -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorder}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="PillGrid" RenderTransformOrigin="0.5,0.5">
                            <!-- Convex Top-Left Specular Light Highlight -->
                            <Border x:Name="PillLightShadow"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="999">
                                <Border.Effect>
                                    <DropShadowEffect Direction="135" ShadowDepth="3" BlurRadius="8"
                                                      Color="{DynamicResource BtnShadowLightColor}"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>

                            <!-- Convex Bottom-Right Dark Shadow -->
                            <Border x:Name="PillDarkShadow"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="999">
                                <Border.Effect>
                                    <DropShadowEffect Direction="315" ShadowDepth="3" BlurRadius="8"
                                                      Color="{DynamicResource BtnShadowDarkColor}"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>

                            <!-- Debossed Inset Plate (Shown when pressed) -->
                            <Border x:Name="PillInsetPlate"
                                    Background="{DynamicResource RecessedBg}"
                                    CornerRadius="999"
                                    Opacity="0"
                                    BorderThickness="1">
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#48080808" Offset="0.0"/>
                                        <GradientStop Color="#18080808" Offset="0.3"/>
                                        <GradientStop Color="#50FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>
                            </Border>

                            <!-- Pill Surface with Micro-Bevel -->
                            <Border x:Name="PillBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="999"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource SecondaryBtnHoverBg}"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource SecondaryBtnHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillGrid" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.985" ScaleY="0.985"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="PillLightShadow" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PillDarkShadow" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0"/>
                                <Setter TargetName="PillInsetPlate" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="PillLightShadow" Property="Opacity" Value="0.2"/>
                                <Setter TargetName="PillDarkShadow" Property="Opacity" Value="0.2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>

        <!-- Debossed / Inset Modern TextBox (Recessed stamped container with inner shadow) -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ModernTextBoxBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ModernTextBoxFg}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- Outer Bevel Rim (border: 1px solid rgba(255,255,255,0.3)) -->
                        <Border CornerRadius="16"
                                BorderBrush="{DynamicResource InsetBevelBorder}"
                                BorderThickness="1"
                                Background="{TemplateBinding Background}">
                            <Grid>
                                <!-- Inset Inner Shadow Gradient (Top-Left Dark, Bottom-Right Light) -->
                                <Border CornerRadius="15" BorderThickness="1.5" IsHitTestVisible="False">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{DynamicResource InsetTopDarkColor}" Offset="0.0"/>
                                            <GradientStop Color="{DynamicResource InsetTopMidColor}" Offset="0.25"/>
                                            <GradientStop Color="Transparent" Offset="0.5"/>
                                            <GradientStop Color="{DynamicResource InsetBotLightColor}" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                </Border>

                                <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark / Silver Styled ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SecondaryBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource SecondaryBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- Recent Connection Item: Convex Tactile Card with Dual Shadows and Seamless Screenshot -->
        <Style x:Key="RecentItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource RecentItemBg}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RecentItemBorder}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid x:Name="CardRoot">
                            <!-- Top-Left Light Highlight Shadow -->
                            <Border x:Name="ItemLightShadow"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="16">
                                <Border.Effect>
                                    <DropShadowEffect Direction="135" ShadowDepth="4" BlurRadius="8"
                                                      Color="{DynamicResource ShadowLightColor}"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>

                            <!-- Bottom-Right Dark Shadow -->
                            <Border x:Name="ItemDarkShadow"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="16">
                                <Border.Effect>
                                    <DropShadowEffect Direction="315" ShadowDepth="4" BlurRadius="8"
                                                      Color="{DynamicResource ShadowDarkColor}"
                                                      RenderingBias="Performance"/>
                                </Border.Effect>
                            </Border>

                            <!-- Main Card Surface with Rounded Corners and Content Clipping -->
                            <Border x:Name="ItemCard"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="16"
                                    ClipToBounds="True">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemCard" Property="Background" Value="{DynamicResource RecentItemHoverBg}"/>
                                <Setter TargetName="ItemCard" Property="BorderBrush" Value="{DynamicResource RecentItemHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemCard" Property="BorderBrush" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Wallpaper: clearly visible, rich aesthetic pattern -->
        <Image x:Name="ImgBackground" Source="Assets/background.jpg" Stretch="UniformToFill" Opacity="0.55" IsHitTestVisible="False"/>

        <!-- Soft dark tint for contrast, letting the pattern shine through -->
        <Rectangle x:Name="RectTint" Fill="{DynamicResource WindowTint}" IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: strict 3-column layout so version and buttons NEVER collide -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource HeaderBorder}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand + Version badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Vibe" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Desk" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Light" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BadgeBg}" BorderBrush="{DynamicResource BadgeBorder}" BorderThickness="1" CornerRadius="8"
                                Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtAppVersion" Text="v1.6.0" Foreground="{DynamicResource TextPrimary}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Right: Quick actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Theme Switcher: located strictly to the left of the Firewall button -->
                        <Button x:Name="BtnThemeToggle" Style="{StaticResource PillButton}" Content="🎨 Серебро"
                                Margin="0,0,10,0" Click="BtnThemeToggle_Click"
                                ToolTip="Сменить тему оформления (Серебро Неоморфизм / Классика)"/>
                        <Button x:Name="BtnFirewall" Style="{StaticResource PillButton}" Content="Брандмауэр"
                                Margin="0,0,10,0" Click="BtnFirewall_Click"
                                ToolTip="Разрешить входящие подключения в Брандмауэре Windows"/>
                        <Button x:Name="BtnCheckUpdate" Style="{StaticResource PillButton}" Content="Обновления"
                                Click="BtnCheckUpdate_Click"
                                ToolTip="Проверить наличие обновлений на GitHub"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Update Notification Banner -->
            <Border x:Name="BannerUpdate" Grid.Row="1" Visibility="Collapsed"
                    Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1"
                    CornerRadius="8" Margin="14,10,14,0" Padding="16,12">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnApplyUpdate" Style="{StaticResource PrimaryButton}"
                                Content="Обновить" Padding="14,6" Margin="10,0,0,0" Click="BtnApplyUpdate_Click"/>
                        <Button x:Name="BtnManualDownload" Style="{StaticResource SecondaryButton}"
                                Content="Скачать с сайта" Padding="12,6" Margin="8,0,0,0" Click="BtnManualDownload_Click"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="✕" Width="28" Height="28"
                                Padding="0" Margin="8,0,0,0" Click="BtnCloseUpdateBanner_Click"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Доступна новая версия:" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="TxtUpdateNewVersion" Text="v1.5.1" Foreground="{DynamicResource AccentColor}"
                                       FontWeight="Bold" FontSize="13" Margin="8,0,0,0"/>
                            <TextBlock x:Name="TxtUpdateSize" Text="" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtUpdateStatus" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,4,0,0"
                                   Text="Нажмите «Обновить» для загрузки новой версии и быстрого перезапуска."/>
                        <ProgressBar x:Name="PbUpdateProgress" Visibility="Collapsed" Height="4" Margin="0,8,0,0"
                                     Foreground="{DynamicResource AccentColor}" Background="{DynamicResource LogBoxBg}" BorderThickness="0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main Content Area: Left = Recent Connections, Right = This PC + Remote Control -->
            <Grid Grid.Row="2" Margin="14,10,14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="370"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Recent Connections (Clean tactile extruded panel) -->
                <ContentControl Grid.Column="0" Style="{StaticResource GlassPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Heading -->
                        <TextBlock Grid.Row="0" Text="Недавние подключения" Foreground="{DynamicResource TextPrimary}"
                                   FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <!-- List / Empty state -->
                        <Grid Grid.Row="1">
                            <!-- Empty State -->
                            <StackPanel x:Name="PanelRecentEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Нет недавних подключений" Foreground="{DynamicResource TextPrimary}" FontSize="13"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <TextBlock Text="Здесь появятся компьютеры после первого подключения." Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- List -->
                            <ListBox x:Name="ListRecentConnections"
                                     Style="{StaticResource CleanListBox}"
                                     ItemContainerStyle="{StaticResource RecentItemStyle}"
                                     SelectionChanged="ListRecentConnections_SelectionChanged"
                                     PreviewMouseLeftButtonUp="ListRecentConnections_PreviewMouseLeftButtonUp"
                                     MouseDoubleClick="ListRecentConnections_MouseDoubleClick"
                                     Visibility="Collapsed">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Удалить из недавних" Click="MenuItemRemoveRecent_Click"/>
                                        <MenuItem Header="Очистить все недавние" Click="MenuItemClearAllRecent_Click"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="82" ClipToBounds="True">
                                            <!-- Background Layer 1: High quality screenshot on the left -->
                                            <Image Source="{Binding ThumbnailSource}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Width="230"
                                                   Height="82"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                                        <GradientStop Color="#E0FFFFFF" Offset="0.25"/>
                                                        <GradientStop Color="#50FFFFFF" Offset="0.55"/>
                                                        <GradientStop Color="#00FFFFFF" Offset="0.80"/>
                                                    </LinearGradientBrush>
                                                </Image.OpacityMask>
                                            </Image>

                                            <!-- Layer 2: Dynamic theme gradient blend seamlessly into card background -->
                                            <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="{DynamicResource RecentFadeStartColor}" Offset="0.0"/>
                                                        <GradientStop Color="{DynamicResource RecentFadeMidColor}" Offset="0.32"/>
                                                        <GradientStop Color="{DynamicResource RecentFadeEndColor}" Offset="0.65"/>
                                                        <GradientStop Color="{DynamicResource RecentFadeEndColor}" Offset="1.0"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>

                                            <!-- Layer 3: Connection Info & Action Button -->
                                            <Grid Margin="16,8,16,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Right side: Status, ID & Subtitle -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                                                    <!-- Status dot + ID -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="8.5" Height="8.5" Fill="{Binding StatusBrush}"
                                                                 ToolTip="{Binding StatusToolTip}"
                                                                 Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect BlurRadius="6" Color="#16a34a" Opacity="0.85" ShadowDepth="0"/>
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding FormattedId}" Foreground="{DynamicResource TextPrimary}"
                                                                   FontSize="16" FontWeight="ExtraBold" FontFamily="Segoe UI, Consolas"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Subtitle: status state and timestamp -->
                                                    <TextBlock Text="{Binding StatusSubtitle}" Foreground="{DynamicResource TextSecondary}"
                                                               FontSize="11" Margin="16.5,4,0,0"/>
                                                </StackPanel>

                                                <!-- Volumetric Circular Arrow Button with Dual Shadows -->
                                                <Grid Grid.Column="2" Width="32" Height="32" VerticalAlignment="Center">
                                                    <Border CornerRadius="16" Background="{DynamicResource ArrowBtnBg}">
                                                        <Border.Effect>
                                                            <DropShadowEffect Direction="135" ShadowDepth="2" BlurRadius="5"
                                                                              Color="{DynamicResource BtnShadowLightColor}"
                                                                              RenderingBias="Performance"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <Border CornerRadius="16" Background="{DynamicResource ArrowBtnBg}">
                                                        <Border.Effect>
                                                            <DropShadowEffect Direction="315" ShadowDepth="2" BlurRadius="5"
                                                                              Color="{DynamicResource BtnShadowDarkColor}"
                                                                              RenderingBias="Performance"/>
                                                        </Border.Effect>
                                                    </Border>
                                                    <Border CornerRadius="16" Background="{DynamicResource ArrowBtnBg}"
                                                            BorderBrush="{DynamicResource ArrowBtnBorder}"
                                                            BorderThickness="1">
                                                        <TextBlock Text="→" Foreground="{DynamicResource TextPrimary}" FontSize="15" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,-1,0,0"/>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </ContentControl>

                <!-- RIGHT: This PC + Remote Control -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Block 1: Этот компьютер (ТОЛЬКО ID, статус и копирование) -->
                    <ContentControl Grid.Row="0" Style="{StaticResource GlassPanel}">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnCopyId" Style="{StaticResource SecondaryButton}" Content="Копировать"
                                        Click="BtnCopyId_Click" Padding="18,9" ToolTip="Скопировать Vibe ID в буфер обмена"/>
                            </StackPanel>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Этот компьютер" Foreground="{DynamicResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="IndicatorHost" Background="#16a34a" Width="10" Height="10"
                                            CornerRadius="5" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" Color="#16a34a" Opacity="0.85" ShadowDepth="0"/>
                                        </Border.Effect>
                                    </Border>
                                    <TextBlock x:Name="TxtMyId" Text="--- ---" Foreground="{DynamicResource TextPrimary}"
                                               FontSize="32" FontWeight="ExtraBold" FontFamily="Segoe UI, Consolas"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtHostStatus" Text="Ожидание подключения..." Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </ContentControl>

                    <!-- Block 2: Удаленное управление (Чистый вид без вложенных коробок) -->
                    <ContentControl Grid.Row="1" Style="{StaticResource GlassPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Heading -->
                            <TextBlock Grid.Row="0" Text="Удалённое управление" Foreground="{DynamicResource TextPrimary}"
                                       FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <!-- Input Row -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtRemoteAddress"
                                             Style="{StaticResource ModernTextBox}"
                                             Text="" KeyDown="TxtRemoteAddress_KeyDown"
                                             Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" x:Name="BtnConnect"
                                             Style="{StaticResource PrimaryButton}"
                                             Content="Подключиться" Click="BtnConnect_Click"
                                             Padding="26,11"/>
                                </Grid>
                                <TextBlock Text="Введите Vibe ID или IP:порт удаленного компьютера."
                                           Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="2,6,0,0"/>
                            </StackPanel>

                            <!-- Journal (Debossed recessed terminal) -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Журнал" Foreground="{DynamicResource TextPrimary}" FontSize="13"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SecondaryButton}" Content="Копировать"
                                                Padding="12,5" Margin="0,0,8,0" Click="BtnCopyLogs_Click"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="Очистить"
                                                Padding="12,5" Click="BtnClearLogs_Click"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Inset Recessed Log Box with Inner Shadow Gradient -->
                                <Border Grid.Row="1" Background="{DynamicResource LogBoxBg}"
                                        BorderBrush="{DynamicResource InsetBevelBorder}"
                                        BorderThickness="1" CornerRadius="16">
                                    <Grid>
                                        <!-- Inset Inner Shadow Gradient (Top-Left Dark, Bottom-Right Light) -->
                                        <Border CornerRadius="15" BorderThickness="1.5" IsHitTestVisible="False">
                                            <Border.BorderBrush>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="{DynamicResource InsetTopDarkColor}" Offset="0.0"/>
                                                    <GradientStop Color="{DynamicResource InsetTopMidColor}" Offset="0.25"/>
                                                    <GradientStop Color="Transparent" Offset="0.5"/>
                                                    <GradientStop Color="{DynamicResource InsetBotLightColor}" Offset="1.0"/>
                                                </LinearGradientBrush>
                                            </Border.BorderBrush>
                                        </Border>

                                        <ScrollViewer x:Name="ScrollLogs" VerticalScrollBarVisibility="Auto" Padding="14,10">
                                            <TextBox x:Name="TxtClientLog"
                                                     Background="Transparent"
                                                     Foreground="{DynamicResource LogBoxFg}"
                                                     BorderThickness="0"
                                                     FontFamily="Consolas, Segoe UI Mono, monospace"
                                                     FontSize="11"
                                                     IsReadOnly="True"
                                                     TextWrapping="Wrap"
                                                     VerticalScrollBarVisibility="Disabled"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </ContentControl>
                </Grid>
            </Grid>

            <!-- Footer: Minimal clean line -->
            <Border Grid.Row="3" Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource FooterBorder}" BorderThickness="0,1,0,0" Padding="24,10">
                <DockPanel>
                    <TextBlock x:Name="TxtFooterStatus" Text="VibeDesk P2P, UDP direct"
                               Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtFooterVersion" Visibility="Collapsed"/>
                </DockPanel>
            </Border>

            <!-- Hidden Functional Controls (Preserves C# bindings without cluttering the UI) -->
            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="TxtCaptureEngine"/>
                <TextBlock x:Name="TxtLocalIp"/>
                <TextBlock x:Name="TxtPublicEndpoint"/>
                <Button x:Name="BtnFixFirewall"/>
                <ComboBox x:Name="CmbResolution">
                    <ComboBoxItem Content="100%"/>
                    <ComboBoxItem Content="75%"/>
                    <ComboBoxItem Content="50%"/>
                    <ComboBoxItem Content="33%"/>
                </ComboBox>
                <ComboBox x:Name="CmbFps">
                    <ComboBoxItem Content="120 FPS"/>
                    <ComboBoxItem Content="60 FPS"/>
                    <ComboBoxItem Content="30 FPS"/>
                </ComboBox>
            </StackPanel>
        </Grid>
    </Grid>
</Window>