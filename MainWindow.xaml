<Window x:Class="VibeDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VibeDesk - Высокоскоростной Remote Desktop" Height="580" Width="840"
        WindowStartupLocation="CenterScreen"
        Background="#0F1015"
        Foreground="#ECEEF4"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <!-- Dark Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#171922"/>
            <Setter Property="BorderBrush" Value="#25293A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="10"/>
        </Style>

        <!-- Modern Action Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#00C853"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00E676"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A303C"/>
                    <Setter Property="Foreground" Value="#656B7D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#25293A"/>
            <Setter Property="Foreground" Value="#D0D4E4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#32384E"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Input TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0D0E13"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#30354A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="#00E5FF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#13141B" BorderBrush="#202330" BorderThickness="0,0,0,1" Padding="24,16">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="⚡ VIBE" Foreground="#00E5FF" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="DESK" Foreground="#ECEEF4" FontSize="20" FontWeight="Light" VerticalAlignment="Center"/>
                    <Border Background="#25293A" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PRO / P2P" Foreground="#00E5FF" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Без ограничений и подписок" Foreground="#7A8098" FontSize="12" VerticalAlignment="Center" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <!-- Body: Two main cards (Host and Client) -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Card: Host (This PC) -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="ЭТОТ КОМПЬЮТЕР" Foreground="#00E5FF" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="Ваше рабочее место готово к подключению" Foreground="#858B9E" FontSize="12" Margin="0,4,0,16"/>
                    </StackPanel>

                    <!-- ID Display Box -->
                    <Border Grid.Row="1" Background="#0C0D12" BorderBrush="#262A3C" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Ваш Vibe ID:" Foreground="#71778B" FontSize="11" FontWeight="SemiBold"/>
                            <DockPanel Margin="0,6,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Копировать" Click="BtnCopyId_Click"/>
                                <TextBlock x:Name="TxtMyId" Text="--- ---" Foreground="#FFFFFF" FontSize="28" FontWeight="Bold"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Host Information List -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Top">
                        <DockPanel Margin="0,4">
                            <TextBlock Text="Статус:" Foreground="#71778B" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border x:Name="IndicatorHost" Background="#00C853" Width="8" Height="8" CornerRadius="4" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtHostStatus" Text="Ожидание подключения..." Foreground="#E0E0E0" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DockPanel>

                        <DockPanel Margin="0,6">
                            <TextBlock Text="Движок захвата:" Foreground="#71778B" FontSize="12"/>
                            <TextBlock x:Name="TxtCaptureEngine" Text="DirectX 11 (DXGI) 60 FPS" Foreground="#00E5FF" FontSize="12" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </DockPanel>

                        <DockPanel Margin="0,6">
                            <TextBlock Text="Локальный IP (для дивана):" Foreground="#71778B" FontSize="12"/>
                            <TextBlock x:Name="TxtLocalIp" Text="192.168.x.x:15890" Foreground="#ECEEF4" FontSize="12" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <DockPanel Margin="0,6">
                            <TextBlock Text="Глобальный STUN:" Foreground="#71778B" FontSize="12"/>
                            <TextBlock x:Name="TxtPublicEndpoint" Text="Определение..." Foreground="#A0A5B8" FontSize="12" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- Quality / FPS selector -->
                    <Border Grid.Row="3" Background="#13151D" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <DockPanel>
                            <TextBlock Text="Частота кадров:" Foreground="#858B9E" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbFps" Width="100" HorizontalAlignment="Right" SelectedIndex="0" SelectionChanged="CmbFps_SelectionChanged">
                                <ComboBoxItem Content="60 FPS"/>
                                <ComboBoxItem Content="30 FPS"/>
                            </ComboBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right Card: Connect to Remote PC -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="УДАЛЕННОЕ УПРАВЛЕНИЕ" Foreground="#00E5FF" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="Подключитесь к домашнему ПК или серверу" Foreground="#858B9E" FontSize="12" Margin="0,4,0,16"/>
                    </StackPanel>

                    <!-- Remote ID / IP input -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Text="Введите Vibe ID или IP:Порт:" Foreground="#A0A5B8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtRemoteAddress" Style="{StaticResource ModernTextBox}" Text="" KeyDown="TxtRemoteAddress_KeyDown"/>
                        <TextBlock Text="Пример: 849 203 (через интернет) или 192.168.1.50 (дома)" Foreground="#5E6377" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Connect Action Button -->
                    <Button Grid.Row="2" x:Name="BtnConnect" Style="{StaticResource PrimaryButton}" Content="⚡ Подключиться" Margin="0,0,0,10" Click="BtnConnect_Click"/>

                    <!-- Connection status & logs -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="Журнал событий и диагностика:" Foreground="#858B9E" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButton}" Content="Копировать" Padding="6,2" Margin="0,0,4,0" Click="BtnCopyLogs_Click"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="Очистить" Padding="6,2" Click="BtnClearLogs_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1" Background="#0C0D12" BorderBrush="#202330" BorderThickness="1" CornerRadius="6" Padding="10">
                            <ScrollViewer x:Name="ScrollLogs" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="TxtClientLog"
                                         Background="Transparent"
                                         Foreground="#8F96AB"
                                         BorderThickness="0"
                                         FontFamily="Consolas, Segoe UI Mono, monospace"
                                         FontSize="11"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Disabled"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- Quick couch connection hint -->
                    <Border Grid.Row="4" Background="#13151D" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <TextBlock Text="💡 Для дивана в той же квартире используйте локальный IP — это даст минимальный пинг (1 мс)!" Foreground="#858B9E" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#0D0E13" BorderBrush="#1C1E28" BorderThickness="0,1,0,0" Padding="16,8">
            <DockPanel>
                <TextBlock x:Name="TxtFooterStatus" Text="VibeDesk P2P Online • UDP Direct Tunnel Ready" Foreground="#5E6377" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="VibeDesk v1.0.0" Foreground="#5E6377" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
