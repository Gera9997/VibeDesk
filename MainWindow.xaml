<Window x:Class="VibeDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VibeDesk" Height="640" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI"
        ResizeMode="CanMinimize"
        Icon="Assets/icon.ico">

    <Window.Resources>
        <!-- Dynamic Palette Brushes for Live Theme Switching -->
        <SolidColorBrush x:Key="WindowBg" Color="#191716"/>
        <SolidColorBrush x:Key="WindowTint" Color="#50191716"/>
        <SolidColorBrush x:Key="HeaderBg" Color="#C0181312"/>
        <SolidColorBrush x:Key="HeaderBorder" Color="#305C423E"/>
        <SolidColorBrush x:Key="FooterBg" Color="#C0181312"/>
        <SolidColorBrush x:Key="FooterBorder" Color="#305C423E"/>
        <SolidColorBrush x:Key="GlassPanelBg" Color="#A61C1716"/>
        <SolidColorBrush x:Key="GlassPanelBorder" Color="#405C423E"/>
        <SolidColorBrush x:Key="AccentColor" Color="#C2A878"/>
        <SolidColorBrush x:Key="PrimaryBtnBg" Color="#773344"/>
        <SolidColorBrush x:Key="PrimaryBtnFg" Color="#C2A878"/>
        <SolidColorBrush x:Key="SecondaryBtnBg" Color="#402D2220"/>
        <SolidColorBrush x:Key="SecondaryBtnBorder" Color="#405C423E"/>
        <SolidColorBrush x:Key="SecondaryBtnFg" Color="#C2A878"/>
        <SolidColorBrush x:Key="ModernTextBoxBg" Color="#8014100F"/>
        <SolidColorBrush x:Key="ModernTextBoxBorder" Color="#505C423E"/>
        <SolidColorBrush x:Key="ModernTextBoxFg" Color="#F0EAE0"/>
        <SolidColorBrush x:Key="LogBoxBg" Color="#500E0B0A"/>
        <SolidColorBrush x:Key="LogBoxBorder" Color="#305C423E"/>
        <SolidColorBrush x:Key="LogBoxFg" Color="#9C9286"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0EAE0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8A7F74"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6E645A"/>
        <SolidColorBrush x:Key="RecentItemBg" Color="#35201B19"/>
        <SolidColorBrush x:Key="RecentItemBorder" Color="#255C423E"/>
        <SolidColorBrush x:Key="ThumbnailBg" Color="#1A1413"/>
        <SolidColorBrush x:Key="ThumbnailBorder" Color="#35C2A878"/>
        <SolidColorBrush x:Key="ArrowBtnBg" Color="#25773344"/>
        <SolidColorBrush x:Key="ArrowBtnBorder" Color="#40773344"/>
        <SolidColorBrush x:Key="BadgeBg" Color="#352623"/>
        <SolidColorBrush x:Key="BadgeBorder" Color="#505C423E"/>

        <!-- Dynamic Gradient / Theme Placeholders for Neumorphism -->
        <SolidColorBrush x:Key="PrimaryBtnBorder" Color="#70757C"/>
        <SolidColorBrush x:Key="PrimaryBtnHoverBg" Color="#D2D6DC"/>
        <SolidColorBrush x:Key="PrimaryBtnHoverBorder" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="PrimaryBtnPressedBg" Color="#9FA4AA"/>
        <SolidColorBrush x:Key="PrimaryBtnPressedBorder" Color="#50545A"/>
        <SolidColorBrush x:Key="SecondaryBtnHoverBg" Color="#282833"/>
        <SolidColorBrush x:Key="SecondaryBtnHoverBorder" Color="#787896"/>
        <SolidColorBrush x:Key="SecondaryBtnPressedBg" Color="#101015"/>
        <SolidColorBrush x:Key="SecondaryBtnPressedBorder" Color="#383846"/>
        <SolidColorBrush x:Key="RecentItemHoverBg" Color="#262632"/>
        <SolidColorBrush x:Key="RecentItemHoverBorder" Color="#657080"/>
        <SolidColorBrush x:Key="ArrowBtnHoverBg" Color="#404050"/>
        <SolidColorBrush x:Key="ArrowBtnHoverBorder" Color="#787892"/>

        <!-- Neumorphic Surface Panel (Soft raised tactile card) -->
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource GlassPanelBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GlassPanelBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" Direction="270" ShadowDepth="5" Color="#000000" Opacity="0.55" RenderingBias="Performance"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button (Convex tactile button with metallic bevel & soft shadow) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource PrimaryBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="BtnShadow"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="14">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="4" Color="#000000" Opacity="0.55"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="BtnBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource PrimaryBtnHoverBg}"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBtnHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource PrimaryBtnPressedBg}"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBtnPressedBorder}"/>
                                <Setter TargetName="BtnBorder" Property="Margin" Value="0,2,0,-2"/>
                                <Setter TargetName="BtnShadow" Property="Margin" Value="0,2,0,-2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="BtnShadow" Property="Opacity" Value="0.2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button (Soft raised convex pill with ambient bevel & soft shadow) -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SecondaryBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryBtnFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorder}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="SecShadow"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="3" Color="#000000" Opacity="0.45"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="SecBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="{DynamicResource SecondaryBtnHoverBg}"/>
                                <Setter TargetName="SecBorder" Property="BorderBrush" Value="{DynamicResource SecondaryBtnHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecBorder" Property="Background" Value="{DynamicResource SecondaryBtnPressedBg}"/>
                                <Setter TargetName="SecBorder" Property="BorderBrush" Value="{DynamicResource SecondaryBtnPressedBorder}"/>
                                <Setter TargetName="SecBorder" Property="Margin" Value="0,2,0,-2"/>
                                <Setter TargetName="SecShadow" Property="Margin" Value="0,2,0,-2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SecBorder" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="SecShadow" Property="Opacity" Value="0.2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>

        <!-- Modern Input TextBox (Concave / Inset debossed container) -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ModernTextBoxBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ModernTextBoxFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ModernTextBoxBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="TxtBoxBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Styled ComboBox (prevents white-on-white text issues) -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource SecondaryBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource SecondaryBtnBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <!-- Recent Connection Item: Seamless Neumorphic Card with Large Screenshot Gradient -->
        <Style x:Key="RecentItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource RecentItemBg}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RecentItemBorder}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <!-- Ambient soft shadow -->
                            <Border x:Name="ItemShadow"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="16"
                                    Margin="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Color="#000000" Opacity="0.45"/>
                                </Border.Effect>
                            </Border>

                            <!-- Main Card with Rounded Corners and Content Clipping -->
                            <Border x:Name="ItemCard"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="16"
                                    ClipToBounds="True">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemCard" Property="Background" Value="{DynamicResource RecentItemHoverBg}"/>
                                <Setter TargetName="ItemCard" Property="BorderBrush" Value="{DynamicResource RecentItemHoverBorder}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemCard" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Wallpaper: clearly visible, rich aesthetic pattern -->
        <Image x:Name="ImgBackground" Source="Assets/background.jpg" Stretch="UniformToFill" Opacity="0.55" IsHitTestVisible="False"/>

        <!-- Soft dark tint for contrast, letting the pattern shine through -->
        <Rectangle x:Name="RectTint" Fill="{DynamicResource WindowTint}" IsHitTestVisible="False"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header: strict 3-column layout so version and buttons NEVER collide -->
            <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource HeaderBorder}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brand + Version badge -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Vibe" Foreground="{DynamicResource AccentColor}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="Desk" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="Light" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BadgeBg}" BorderBrush="{DynamicResource BadgeBorder}" BorderThickness="1" CornerRadius="5"
                                Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtAppVersion" Text="v1.6.0" Foreground="{DynamicResource AccentColor}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Right: Quick actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Theme Switcher: located strictly to the left of the Firewall button -->
                        <Button x:Name="BtnThemeToggle" Style="{StaticResource SecondaryButton}" Content="🎨 Серебро"
                                Margin="0,0,10,0" Click="BtnThemeToggle_Click"
                                ToolTip="Сменить тему оформления (Черный #080808 + Серебристый #BFC3C7 / Классика)"/>
                        <Button x:Name="BtnFirewall" Style="{StaticResource SecondaryButton}" Content="Брандмауэр"
                                Margin="0,0,10,0" Click="BtnFirewall_Click"
                                ToolTip="Разрешить входящие подключения в Брандмауэре Windows"/>
                        <Button x:Name="BtnCheckUpdate" Style="{StaticResource SecondaryButton}" Content="Обновления"
                                Click="BtnCheckUpdate_Click"
                                ToolTip="Проверить наличие обновлений на GitHub"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Update Notification Banner -->
            <Border x:Name="BannerUpdate" Grid.Row="1" Visibility="Collapsed"
                    Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1"
                    CornerRadius="8" Margin="14,10,14,0" Padding="16,12">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnApplyUpdate" Style="{StaticResource PrimaryButton}"
                                Content="Обновить" Padding="14,6" Margin="10,0,0,0" Click="BtnApplyUpdate_Click"/>
                        <Button x:Name="BtnManualDownload" Style="{StaticResource SecondaryButton}"
                                Content="Скачать с сайта" Padding="12,6" Margin="8,0,0,0" Click="BtnManualDownload_Click"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="✕" Width="28" Height="28"
                                Padding="0" Margin="8,0,0,0" Click="BtnCloseUpdateBanner_Click"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Доступна новая версия:" Foreground="{DynamicResource TextPrimary}" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="TxtUpdateNewVersion" Text="v1.5.1" Foreground="{DynamicResource AccentColor}"
                                       FontWeight="Bold" FontSize="13" Margin="8,0,0,0"/>
                            <TextBlock x:Name="TxtUpdateSize" Text="" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtUpdateStatus" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="0,4,0,0"
                                   Text="Нажмите «Обновить» для загрузки новой версии и быстрого перезапуска."/>
                        <ProgressBar x:Name="PbUpdateProgress" Visibility="Collapsed" Height="4" Margin="0,8,0,0"
                                     Foreground="{DynamicResource AccentColor}" Background="{DynamicResource LogBoxBg}" BorderThickness="0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Main Content Area: Left = Recent Connections, Right = This PC + Remote Control -->
            <Grid Grid.Row="2" Margin="12,8,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Recent Connections (Clean single panel, no nested frames) -->
                <Border Grid.Column="0" Style="{StaticResource GlassPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Heading -->
                        <TextBlock Grid.Row="0" Text="Недавние подключения" Foreground="{DynamicResource AccentColor}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <!-- List / Empty state -->
                        <Grid Grid.Row="1">
                            <!-- Empty State -->
                            <StackPanel x:Name="PanelRecentEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="Нет недавних подключений" Foreground="{DynamicResource TextSecondary}" FontSize="13"
                                           FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/>
                                <TextBlock Text="Здесь появятся компьютеры после первого подключения." Foreground="{DynamicResource TextMuted}"
                                           FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- List -->
                            <ListBox x:Name="ListRecentConnections"
                                     Style="{StaticResource CleanListBox}"
                                     ItemContainerStyle="{StaticResource RecentItemStyle}"
                                     SelectionChanged="ListRecentConnections_SelectionChanged"
                                     PreviewMouseLeftButtonUp="ListRecentConnections_PreviewMouseLeftButtonUp"
                                     MouseDoubleClick="ListRecentConnections_MouseDoubleClick"
                                     Visibility="Collapsed">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Удалить из недавних" Click="MenuItemRemoveRecent_Click"/>
                                        <MenuItem Header="Очистить все недавние" Click="MenuItemClearAllRecent_Click"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="82" ClipToBounds="True">
                                            <!-- Background Layer 1: Large Edge-to-Edge Screenshot spanning across -->
                                            <Image Source="{Binding ThumbnailSource}"
                                                   Stretch="UniformToFill"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Width="260"
                                                   Height="82">
                                                <Image.OpacityMask>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                                        <GradientStop Color="#E8FFFFFF" Offset="0.30"/>
                                                        <GradientStop Color="#60FFFFFF" Offset="0.65"/>
                                                        <GradientStop Color="#00FFFFFF" Offset="0.96"/>
                                                    </LinearGradientBrush>
                                                </Image.OpacityMask>
                                            </Image>

                                            <!-- Layer 2: Smooth dark gradient blend across the full card width -->
                                            <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00000000" Offset="0.0"/>
                                                        <GradientStop Color="#1008080A" Offset="0.25"/>
                                                        <GradientStop Color="#8508080A" Offset="0.55"/>
                                                        <GradientStop Color="#EA08080A" Offset="0.80"/>
                                                        <GradientStop Color="#FF08080A" Offset="0.95"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>

                                            <!-- Layer 3: Connection Info & Action Button -->
                                            <Grid Margin="16,8,16,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Right side: Status, ID & Subtitle -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                                                    <!-- Status dot + ID -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="8.5" Height="8.5" Fill="{Binding StatusBrush}"
                                                                 ToolTip="{Binding StatusToolTip}"
                                                                 Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Ellipse.Effect>
                                                                <DropShadowEffect BlurRadius="6" Color="#00E676" Opacity="0.7" ShadowDepth="0"/>
                                                            </Ellipse.Effect>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding FormattedId}" Foreground="{DynamicResource TextPrimary}"
                                                                   FontSize="16" FontWeight="Bold" FontFamily="Consolas"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <!-- Subtitle: status state and timestamp -->
                                                    <TextBlock Text="{Binding StatusSubtitle}" Foreground="{DynamicResource TextSecondary}"
                                                               FontSize="11" Margin="16.5,4,0,0"/>
                                                </StackPanel>

                                                <!-- Volumetric Circular Arrow Button -->
                                                <Border Grid.Column="2" Width="32" Height="32" CornerRadius="16"
                                                        Background="{DynamicResource ArrowBtnBg}"
                                                        BorderBrush="{DynamicResource ArrowBtnBorder}"
                                                        BorderThickness="1"
                                                        VerticalAlignment="Center">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="6" Direction="270" ShadowDepth="2" Color="#000000" Opacity="0.4"/>
                                                    </Border.Effect>
                                                    <TextBlock Text="→" Foreground="{DynamicResource AccentColor}" FontSize="15" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,-1,0,0"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <!-- RIGHT: This PC + Remote Control -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Block 1: Этот компьютер (ТОЛЬКО ID, статус и копирование - без лишней инфы) -->
                    <Border Grid.Row="0" Style="{StaticResource GlassPanel}">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button x:Name="BtnCopyId" Style="{StaticResource SecondaryButton}" Content="Копировать"
                                        Click="BtnCopyId_Click" Padding="16,8" ToolTip="Скопировать Vibe ID в буфер обмена"/>
                            </StackPanel>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Этот компьютер" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="IndicatorHost" Background="{DynamicResource AccentColor}" Width="10" Height="10"
                                            CornerRadius="5" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtMyId" Text="--- ---" Foreground="{DynamicResource TextPrimary}"
                                               FontSize="30" FontWeight="Bold" FontFamily="Consolas"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtHostStatus" Text="Ожидание подключения..." Foreground="{DynamicResource TextSecondary}"
                                           FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Block 2: Удаленное управление (Чистый вид без вложенных коробок) -->
                    <Border Grid.Row="1" Style="{StaticResource GlassPanel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Heading -->
                            <TextBlock Grid.Row="0" Text="Удалённое управление" Foreground="{DynamicResource AccentColor}"
                                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,14"/>

                            <!-- Input Row -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtRemoteAddress"
                                             Style="{StaticResource ModernTextBox}"
                                             Text="" KeyDown="TxtRemoteAddress_KeyDown"
                                             Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" x:Name="BtnConnect"
                                             Style="{StaticResource PrimaryButton}"
                                             Content="Подключиться" Click="BtnConnect_Click"
                                             Padding="22,10"/>
                                </Grid>
                                <TextBlock Text="Введите Vibe ID или IP:порт удаленного компьютера."
                                           Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="2,6,0,0"/>
                            </StackPanel>

                            <!-- Journal (Seamless console without double nested frames) -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock Text="Журнал" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SecondaryButton}" Content="Копировать"
                                                Padding="8,3" Margin="0,0,6,0" Click="BtnCopyLogs_Click"/>
                                        <Button Style="{StaticResource SecondaryButton}" Content="Очистить"
                                                Padding="8,3" Click="BtnClearLogs_Click"/>
                                    </StackPanel>
                                </DockPanel>

                                <Border Grid.Row="1" Background="{DynamicResource LogBoxBg}" BorderBrush="{DynamicResource LogBoxBorder}"
                                        BorderThickness="1" CornerRadius="13" Padding="12">
                                    <ScrollViewer x:Name="ScrollLogs" VerticalScrollBarVisibility="Auto">
                                        <TextBox x:Name="TxtClientLog"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource LogBoxFg}"
                                                 BorderThickness="0"
                                                 FontFamily="Consolas, Segoe UI Mono, monospace"
                                                 FontSize="11"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Disabled"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Footer: Minimal clean line -->
            <Border Grid.Row="3" Background="{DynamicResource FooterBg}" BorderBrush="{DynamicResource FooterBorder}" BorderThickness="0,1,0,0" Padding="20,8">
                <DockPanel>
                    <TextBlock x:Name="TxtFooterStatus" Text="VibeDesk P2P, UDP direct"
                               Foreground="{DynamicResource TextMuted}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtFooterVersion" Visibility="Collapsed"/>
                </DockPanel>
            </Border>

            <!-- Hidden Functional Controls (Preserves C# bindings without cluttering the UI) -->
            <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="TxtCaptureEngine"/>
                <TextBlock x:Name="TxtLocalIp"/>
                <TextBlock x:Name="TxtPublicEndpoint"/>
                <Button x:Name="BtnFixFirewall"/>
                <ComboBox x:Name="CmbResolution">
                    <ComboBoxItem Content="100%"/>
                    <ComboBoxItem Content="75%"/>
                    <ComboBoxItem Content="50%"/>
                    <ComboBoxItem Content="33%"/>
                </ComboBox>
                <ComboBox x:Name="CmbFps">
                    <ComboBoxItem Content="120 FPS"/>
                    <ComboBoxItem Content="60 FPS"/>
                    <ComboBoxItem Content="30 FPS"/>
                </ComboBox>
            </StackPanel>
        </Grid>
    </Grid>
</Window>