<Window x:Class="VibeDesk.UI.RemoteSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VibeDesk - Удаленный сеанс" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#121214"
        Focusable="True"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">
    <Window.Resources>
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A2A32"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D48"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#0D0D11">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Tool Bar -->
        <Border Grid.Row="0" Background="#18181F" BorderBrush="#282836" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="#00C853" Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0"/>
                    <TextBlock Text="Подключено" Foreground="#A0A0B0" FontWeight="SemiBold" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    
                    <TextBlock x:Name="TxtStats" Text="FPS: 0 | Пинг: 0 мс | 0 Кб/с" Foreground="#7A7A90" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Style="{StaticResource HeaderBtn}" Content="📋 Буфер обмена" Click="BtnSyncClipboard_Click" ToolTip="Отправить буфер обмена на удаленный ПК"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="Ctrl+Shift+Esc" Click="BtnTaskMgr_Click" ToolTip="Открыть диспетчер задач"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="Win-Key" Click="BtnWinKey_Click" ToolTip="Нажать клавишу Windows"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="⛶ Полный экран" Click="BtnFullscreen_Click"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="✕ Отключиться" Background="#8A1C1C" Click="BtnDisconnect_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Viewport -->
        <Grid Grid.Row="1" Background="#0A0A0E" ClipToBounds="True">
            <Viewbox Stretch="Uniform">
                <Image x:Name="ImgScreen"
                       Focusable="True"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       MouseMove="ImgScreen_MouseMove"
                       MouseDown="ImgScreen_MouseDown"
                       MouseUp="ImgScreen_MouseUp"
                       MouseWheel="ImgScreen_MouseWheel"/>
            </Viewbox>

            <!-- Loading overlay -->
            <Border x:Name="OverlayConnecting" Background="#CC0D0D11" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#00E5FF" Background="#2A2A36" BorderThickness="0"/>
                    <TextBlock Text="Ожидание первого кадра..." Foreground="#A0A0B0" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
