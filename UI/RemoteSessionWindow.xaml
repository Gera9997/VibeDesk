<Window x:Class="VibeDesk.UI.RemoteSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VibeDesk - Удаленный сеанс" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#121214"
        Focusable="True"
        KeyDown="Window_KeyDown"
        KeyUp="Window_KeyUp">
    <Window.Resources>
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A2A32"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D48"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#0D0D11">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Tool Bar -->
        <Border x:Name="TopToolBar" Grid.Row="0" Background="#18181F" BorderBrush="#282836" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Background="#00C853" Width="7" Height="7" CornerRadius="3.5" Margin="0,0,6,0"/>
                    <TextBlock Text="Подключено" Foreground="#A0A0B0" FontWeight="SemiBold" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    
                    <!-- Prominent Monitor Switcher: Right next to session status, never clipped! -->
                    <StackPanel x:Name="PanelMonitors" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Visible"/>

                    <TextBlock x:Name="TxtStats" Text="FPS: 0 | Пинг: 0 мс | 0 Кб/с" Foreground="#7A7A90" FontSize="10.5" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="LblCodec" Text="Кодек:" Foreground="#C2A878" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbStreamCodec" Width="135" SelectedIndex="0" SelectionChanged="CmbStreamCodec_SelectionChanged" FontSize="10" Margin="0,0,8,0">
                        <ComboBoxItem Content="⚡ Турбо-MJPEG"/>
                        <ComboBoxItem Content="🎬 Видеопоток"/>
                        <ComboBoxItem Content="🚀 Видеопоток v2"/>
                    </ComboBox>

                    <TextBlock Text="Масштаб:" Foreground="#7A7A90" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbLiveMode" Width="95" SelectedIndex="0" SelectionChanged="CmbLiveMode_SelectionChanged" FontSize="10" Margin="0,0,8,0">
                        <ComboBoxItem Content="🎯 100%"/>
                        <ComboBoxItem Content="⚖️ 75%"/>
                        <ComboBoxItem Content="🚀 50% FPS"/>
                        <ComboBoxItem Content="⚡ 33% Эко"/>
                    </ComboBox>

                    <Button Style="{StaticResource HeaderBtn}" Content="📊 F3" Click="BtnTogglePerfDrawer_Click" ToolTip="Открыть подробный лог таймингов этапов стрима (F3)"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="📋 Буфер" Click="BtnSyncClipboard_Click" ToolTip="Отправить буфер обмена на удаленный ПК"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="Диспетчер" Click="BtnTaskMgr_Click" ToolTip="Открыть диспетчер задач (Ctrl+Shift+Esc)"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="Win" Click="BtnWinKey_Click" ToolTip="Нажать клавишу Windows (Win-Key)"/>
                    <Button x:Name="BtnAudio" Style="{StaticResource HeaderBtn}" Content="🔊 Звук" Click="BtnAudio_Click" ToolTip="Включить/выключить звук с удаленного ПК (при выключении пакеты не отправляются)"/>
                    <Button x:Name="BtnGameMode" Style="{StaticResource HeaderBtn}" Content="🎮 Игра" Click="BtnGameMode_Click" ToolTip="Игровой режим: относительное движение мыши для 3D-игр и перехват системных клавиш (Shift+Esc / F10)"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="⛶ Экран" Click="BtnFullscreen_Click" ToolTip="Полноэкранный режим (F11)"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="✕ Выход" Background="#8A1C1C" Click="BtnDisconnect_Click" ToolTip="Отключиться от сеанса"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Viewport -->
        <Grid Grid.Row="1" Background="#0A0A0E" ClipToBounds="True">
            <Viewbox Stretch="Uniform">
                <Image x:Name="ImgScreen"
                       Focusable="True"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       MouseMove="ImgScreen_MouseMove"
                       MouseDown="ImgScreen_MouseDown"
                       MouseUp="ImgScreen_MouseUp"
                       MouseWheel="ImgScreen_MouseWheel"
                       MouseLeave="ImgScreen_MouseLeave"/>
            </Viewbox>

            <!-- Hardware Cursor Overlay (1:1 Native Resolution, NOT magnified by Viewbox) -->
            <Canvas x:Name="CursorCanvas" IsHitTestVisible="False">
                <Path x:Name="RemoteCursor"
                      Data="M 0,0 L 0,16 L 4.5,12.5 L 8,19 L 10.5,17.5 L 7,11 L 12,11 Z"
                      Fill="#FFFFFF"
                      Stroke="#191716"
                      StrokeThickness="1.2"
                      Visibility="Collapsed"/>
            </Canvas>

            <!-- Game Mode Corner Transparent Hint -->
            <Border x:Name="OverlayGameModeHint"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="12,0,0,12"
                    Background="#7508080A" BorderBrush="#5500C853" BorderThickness="1"
                    CornerRadius="5" Padding="8,4"
                    Opacity="0.75"
                    Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock Text="🎮 Игровой режим (Shift+Esc / F10)"
                           Foreground="#E0E0E0" FontSize="10" FontWeight="SemiBold"/>
            </Border>

            <!-- Loading overlay -->
            <Border x:Name="OverlayConnecting" Background="#CC0D0D11" Visibility="Visible">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#00E5FF" Background="#2A2A36" BorderThickness="0"/>
                    <TextBlock x:Name="TxtConnectingStatus" Text="Ожидание первого кадра..." Foreground="#A0A0B0" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Diagnostics Drawer -->
            <Border x:Name="DrawerPerfLogs" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="520"
                    Background="#F0101016" BorderBrush="#353545" BorderThickness="1,0,0,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource HeaderBtn}" Content="✕" Width="26" Height="26" Padding="0" Click="BtnClosePerfDrawer_Click"/>
                        <TextBlock Text="📊 Диагностика и тайминги видеопотока" Foreground="#F0EAE0" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Current Live Summary -->
                    <Border Grid.Row="1" Background="#201C24" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <TextBlock x:Name="TxtLiveSummary" Text="Сбор данных таймингов..." Foreground="#C2A878" FontSize="11" FontFamily="Consolas"/>
                    </Border>

                    <!-- Detailed Log Box -->
                    <TextBox x:Name="TxtPerfLog" Grid.Row="2" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="#0D0D12" Foreground="#8AFFA5" FontFamily="Consolas" FontSize="10" BorderBrush="#252535" Padding="6"/>

                    <!-- Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Style="{StaticResource HeaderBtn}" Content="Очистить" Click="BtnClearPerfLog_Click" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource HeaderBtn}" Content="📂 Открыть лог" Click="BtnOpenPerfLog_Click" Margin="0,0,6,0" ToolTip="Открыть текущий текстовый лог в Блокноте"/>
                        <Button Style="{StaticResource HeaderBtn}" Content="💾 Экспорт в .txt" Background="#2E4A25" Click="BtnExportTxt_Click" Margin="0,0,6,0" ToolTip="Сохранить лог в .txt файл на диске"/>
                        <Button Style="{StaticResource HeaderBtn}" Content="📋 В буфер" Background="#4A3425" Click="BtnCopyPerfLog_Click" ToolTip="Скопировать лог в буфер обмена"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
