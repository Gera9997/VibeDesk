<Window x:Class="VibeDesk.UI.VibeMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        MinWidth="390"
        MaxWidth="520"
        FontFamily="Segoe UI"
        Foreground="#F0EAE0">

    <Window.Resources>
        <!-- Primary Button Style -->
        <Style x:Key="DlgPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#773344"/>
            <Setter Property="Foreground" Value="#C2A878"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#943F53"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="DlgSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#402D2220"/>
            <Setter Property="Foreground" Value="#C2A878"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#405C423E"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#603D2E2B"/>
                    <Setter Property="BorderBrush" Value="#60C2A878"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="20" Background="#F41C1716" BorderBrush="#80773344" BorderThickness="1.5" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="6" Color="#000000" Opacity="0.85"/>
        </Border.Effect>
        <Grid Margin="22,18,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,16" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right" x:Name="BtnClose" Content="✕"
                        Background="Transparent" Foreground="#8A7F74" BorderThickness="0"
                        FontSize="14" Cursor="Hand" Width="24" Height="24"
                        Click="BtnClose_Click"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4" Background="#C2A878" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitle" Text="VibeDesk" Foreground="#C2A878" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>
            </DockPanel>

            <!-- Content Area: Icon + Message -->
            <Grid Grid.Row="1" Margin="2,4,2,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border Grid.Column="0" x:Name="IconBadge" Width="44" Height="44" CornerRadius="22"
                        Background="#25773344" BorderBrush="#60773344" BorderThickness="1.5"
                        VerticalAlignment="Top" Margin="0,2,16,0">
                    <Path x:Name="IconPath" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Stretch="Uniform" Width="20" Height="20" Fill="#C2A878"/>
                </Border>

                <!-- Message Text -->
                <TextBlock Grid.Column="1" x:Name="TxtMessage" Text="Message"
                           Foreground="#F0EAE0" FontSize="13.5" LineHeight="20"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="Отмена" Visibility="Collapsed"
                        Style="{StaticResource DlgSecondaryButton}" Margin="0,0,10,0"
                        Click="BtnCancel_Click"/>
                <Button x:Name="BtnOk" Content="OK"
                        Style="{StaticResource DlgPrimaryButton}"
                        Click="BtnOk_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
